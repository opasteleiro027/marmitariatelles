# Origem pública do serviço web no Railway.
APP_URL=https://seu-app.up.railway.app

# Adaptador substituível de geocodificação reversa. Respeitar a política do provedor.
REVERSE_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
